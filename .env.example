# PostgreSQL (khop docker-compose.yml)
DATABASE_URL="postgresql://english:english_dev_pw@localhost:5432/english_app"

# NextAuth — sinh bang: openssl rand -base64 32
NEXTAUTH_SECRET="thay-bang-chuoi-ngau-nhien-it-nhat-32-ky-tu"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (console.cloud.google.com -> Credentials -> OAuth 2.0 Client ID)
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SMTP gui email reset mat khau / verify (de trong = log link ra console khi dev)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="English App <no-reply@example.com>"

# Admin WebMCP: off | read | write | all
# read: only read tools; write: create/update/import; all: also publish/delete.
WEBMCP_MODE="off"
# Token lấy từ Chrome WebMCP Origin Trial cho origin production; để trống khi dùng local flag.
WEBMCP_ORIGIN_TRIAL_TOKEN=""
MCP_REMOTE_TOKEN=""
MCP_REMOTE_ADMIN_EMAIL="admin@example.com"
MCP_REMOTE_ALLOWED_ORIGINS="http://localhost:3000"

# Remote MCP HTTP adapter (local Agent -> /api/mcp)
# Keep this secret outside source control; generate at least 32 random characters.
MCP_REMOTE_TOKEN=""
# Email of the admin account allowed to act through the remote token.
MCP_REMOTE_ADMIN_EMAIL="admin@example.com"
# Comma-separated browser origins allowed for CORS. Leave empty for server-to-server Agents.
MCP_REMOTE_ALLOWED_ORIGINS="http://localhost:3000"
